# Compiled installer output
Output/

# Bundled Ubuntu rootfs. Too large for git (341 MB, over the 100 MB per-file
# limit), so git cannot see it change; setup.ps1 pins its sha256 and refuses to
# import a mismatch, and scripts\build_release.ps1 fails the build on drift.
# Stock, unmodified Canonical image, nothing added:
#   Ubuntu 22.04.5 LTS (jammy) amd64, image built 2025-03-18
#   https://cloud-images.ubuntu.com/wsl/jammy/20250318/ubuntu-jammy-wsl-amd64-ubuntu22.04lts.rootfs.tar.gz
#   sha256 1483cc5c1dce13064f774834cbffdff226559fd522a67a381a8ea77d63fb4109
#   (Canonical's own published value, from SHA256SUMS in that same directory)
# Use the dated URL; .../wsl/jammy/current/ moves to the newest build.
resources/ubuntu-rootfs.tar.gz

# Embedded ClawFactory Studio installer (v1.1.0 combined build). Sourced from the
# Studio repo's release dir at build time; too large for git. Because git cannot
# see it, scripts\build_release.ps1 pins its sha256 and fails the build on drift.
resources/ClawFactory-Studio-Setup-*.exe

# Inno Setup compiler artifacts
*.~is

# Windows
Thumbs.db
Desktop.ini
*.lnk

# Logs
*.log
logs/

# Any accidentally dropped secrets
.env
*.pfx
*.p12
secrets/

# Generated at build time from .env -- real account/profile values, not the template
signing/metadata.json
signing/tools/

# Node (if any tooling is added)
node_modules/

# 2.4 MB schema dump from openclaw 2026.4.27 phase-3 investigation
# (already covered by *.log above, listed explicitly for clarity)
schema-investigation.log

# Azure validation run artifacts -- per-run generated REPORT.md, .vmname,
# run-meta.txt, install logs, and run-scoped .ps1 wrappers that bake in
# SAS-signed installer URLs (expired tokens but still treated as secrets).
validation-runs/

# Claude Code local state (scheduled task lock, etc.)
.claude/
